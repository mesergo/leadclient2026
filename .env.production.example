NODE_ENV=production
# PORT is provided by Passenger/cPanel — do not hardcode in production.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_leadclient
DB_PASSWORD=__set_in_cpanel__
DB_NAME=cpaneluser_leadclient
JWT_SECRET=__generate_a_long_random_string__
JWT_EXPIRES_IN=7d
UPLOAD_DIR=/home/cpaneluser/leadclient-uploads
# Client is served by the Node app (same origin) → leave API URL empty at build time.
VITE_API_URL=

# Web Push (browser notifications). Generate once with:
#   cd server && node -e "console.log(require('web-push').generateVAPIDKeys())"
# Requires HTTPS in production (AutoSSL). Without these, in-app + SMS still work.
VAPID_PUBLIC_KEY=__generate__
VAPID_PRIVATE_KEY=__generate__
VAPID_SUBJECT=mailto:admin@yourdomain.com

# iCount billing (standing orders). Without ICOUNT_TOKEN, new signups are NOT gated in production.
ICOUNT_TOKEN=__from_iCount_API_Tokens__
# optional: an existing recurring (doctype=hk) PayPage id; empty = auto-created on first checkout
ICOUNT_PAYPAGE_ID=
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_MINUTE_RATE=0.25

# Maskyoo call-report URL, sent on every number update (callback_url_option=3: call start + end).
# Optional — defaults to $APP_URL/api/public/call (or https://app26.leadclient.net/api/public/call).
MASKYOO_CALLBACK_URL=
